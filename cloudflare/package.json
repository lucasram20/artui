{
  "name": "artui-freemodel-relay",
  "version": "0.1.0",
  "private": true,
  "description": "Cloudflare Worker that proxies artui's freemodel requests, keeping the freemodel.dev API key server-side.",
  "scripts": {
    "deploy": "wrangler deploy",
    "dev": "wrangler dev",
    "tail": "wrangler tail",
    "secrets:put": "wrangler secret put FREEMODEL_API_KEY",
    "kv:create": "wrangler kv namespace create FREEMODEL_RATE_LIMIT"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260520.0",
    "typescript": "^5.6.0",
    "wrangler": "^4.0.0"
  }
}

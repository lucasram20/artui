# Rust build output
/target/

# Local editor and OS files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Local environment and secrets
.env
.env.*
!.env.example
*.pem
*.key

# artui runtime/session output
.artui/auth.json
.artui/auth.json.tmp
.artui/session/
.artui/logs/

# Temporary files
*.tmp
*.temp

# Pi local harness/session state (never commit); keep only a safe placeholder tracked
.pi/*
!.pi/README.md

# Graphify outputs: ignore everything except a safe placeholder.
# Avoids HTML/cache dumps polluting GitHub's language stats.
**/graphify-out/*
!**/graphify-out/.gitkeep

graphify-out/cache/
graphify-out/.graphify_python
graphify-out/.graphify_root
graphify-out/cost.json

# npm wrapper build artifacts
npm/dist/
npm/node_modules/
npm/src/node_modules/
npm/vendor/
